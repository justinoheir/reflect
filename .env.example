# Reflection providers (server-side only). Set the key for whichever engine(s)
# you want available in the in-app toggle — you don't need both.

# Groq (Fast, free tier) — runs Llama 3.3 70B. https://console.groq.com/keys
GROQ_API_KEY=...

# Google Gemini (Balanced, free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# OpenAI API key — powers voice-to-text transcription via Whisper (optional).
# Voice entry is disabled gracefully if this is not set.
OPENAI_API_KEY=sk-...
